# Hikmah Environment Configuration

# Application
HIKMAH_ENVIRONMENT=development
HIKMAH_DEBUG=true

# Database (SQLite default for dev, PostgreSQL for production)
HIKMAH_DATABASE_URL=sqlite+aiosqlite:///./hikmah.db

# Mattermost Foundation Integration
HIKMAH_MATTERMOST_URL=http://localhost:8065
HIKMAH_MATTERMOST_BOT_TOKEN=
HIKMAH_MATTERMOST_TEAM_NAME=hikmah

# QwenPaw Runtime
HIKMAH_QWENPAW_ENDPOINT=http://localhost:8080

# PostgreSQL Docker Settings
POSTGRES_USER=mmuser
POSTGRES_PASSWORD=mostest
POSTGRES_DB=mattermost
